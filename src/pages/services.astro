---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComingSoon from '../components/ComingSoon.astro';
---
<BaseLayout
  title="Services"
  description="Event coordination and custom commissions by Katherine Hillesland — details coming soon."
>
  <ComingSoon
    title="Services &amp; Pricing"
    blurb="I'm putting together packages for event coordination and custom commissions. In the meantime, every project starts with a friendly conversation — tell me what you're dreaming up and we'll figure out the details together."
    bullets={[
      'Event coordination & styling with a real point of view',
      'Custom jewelry and handmade commissions',
      'Collaborations for markets, pop-ups, and creative projects',
    ]}
    inquireSubject="Services & pricing inquiry"
  />
</BaseLayout>
