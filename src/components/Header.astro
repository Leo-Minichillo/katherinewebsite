---
import { site } from '../data/site';
import Doodle from './Doodle.astro';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? pathname === '/' : pathname === h || pathname.startsWith(h + '/');
};

const linkBase =
  'relative rounded-full px-4 py-2 text-sm font-bold transition-colors';
const linkOn = 'bg-blush text-bubblegum-ink';
const linkOff = 'text-plum-ink hover:bg-cream-deep hover:text-bubblegum-ink';
---
<header class="sticky top-0 z-50 border-b-2 border-plum-ink/10 bg-cream/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <!-- Brand -->
    <a href="/" class="group flex items-center gap-2" aria-label={`${site.brand} — home`}>
      <span
        class="grid h-9 w-9 place-items-center rounded-full bg-bubblegum text-white shadow-sticker transition-transform group-hover:rotate-12"
      >
        <Doodle name="sparkle" class="h-5 w-5" />
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-hand text-xl text-bubblegum-ink">Katherine's</span>
        <span class="font-display text-lg font-semibold tracking-tight text-plum-ink"
          >Absurdities</span
        >
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class={`${linkBase} ${isActive(item.href) ? linkOn : linkOff}`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-2">
      <a
        href={site.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden h-9 w-9 place-items-center rounded-full text-plum-ink transition-colors hover:bg-cream-deep hover:text-bubblegum-ink sm:grid"
        aria-label="Katherine's Absurdities on Instagram"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.4.37 1 .42 2.2.06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.05 1.2-.25 1.8-.42 2.2-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.4.17-1 .37-2.2.42-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.05-1.8-.25-2.2-.42a3.8 3.8 0 0 1-1.38-.9 3.8 3.8 0 0 1-.9-1.38c-.17-.4-.37-1-.42-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.05-1.2.25-1.8.42-2.2.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.4-.17 1-.37 2.2-.42C8.4 2.2 8.8 2.2 12 2.2Zm0 1.95c-3.15 0-3.5.01-4.75.07-.9.04-1.4.2-1.72.32-.43.17-.74.37-1.06.7-.32.32-.52.63-.7 1.06-.12.32-.28.82-.32 1.72-.06 1.25-.07 1.6-.07 4.75s.01 3.5.07 4.75c.04.9.2 1.4.32 1.72.17.43.37.74.7 1.06.32.32.63.52 1.06.7.32.12.82.28 1.72.32 1.25.06 1.6.07 4.75.07s3.5-.01 4.75-.07c.9-.04 1.4-.2 1.72-.32.43-.17.74-.37 1.06-.7.32-.32.52-.63.7-1.06.12-.32.28-.82.32-1.72.06-1.25.07-1.6.07-4.75s-.01-3.5-.07-4.75c-.04-.9-.2-1.4-.32-1.72a2.85 2.85 0 0 0-.7-1.06 2.85 2.85 0 0 0-1.06-.7c-.32-.12-.82-.28-1.72-.32-1.25-.06-1.6-.07-4.75-.07Zm0 3.32a4.53 4.53 0 1 1 0 9.06 4.53 4.53 0 0 1 0-9.06Zm0 7.47a2.94 2.94 0 1 0 0-5.88 2.94 2.94 0 0 0 0 5.88Zm5.77-7.69a1.06 1.06 0 1 1-2.12 0 1.06 1.06 0 0 1 2.12 0Z"
          />
        </svg>
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="menu-btn"
        type="button"
        class="grid h-10 w-10 place-items-center rounded-full border-2 border-plum-ink/15 text-plum-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg id="menu-open-icon" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <svg id="menu-close-icon" viewBox="0 0 24 24" class="hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t-2 border-plum-ink/10 bg-cream md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3" aria-label="Mobile">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class={`rounded-2xl px-4 py-3 text-base font-bold ${
              isActive(item.href) ? 'bg-blush text-bubblegum-ink' : 'text-plum-ink'
            }`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-1 rounded-2xl px-4 py-3 text-base font-bold text-bubblegum-ink"
      >
        Instagram ↗
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  function setOpen(open: boolean) {
    if (!menu || !btn) return;
    menu.classList.toggle('hidden', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden');
    setOpen(Boolean(isOpen));
  });

  // Close the menu when a link is tapped or the viewport grows to desktop.
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
