---
import { site } from '../data/site';
import Doodle from './Doodle.astro';
import Button from './Button.astro';
---
<section class="mx-auto max-w-6xl px-4 sm:px-6">
  <div class="relative overflow-hidden rounded-blob bg-gradient-to-br from-bubblegum to-cherry px-6 py-12 text-center text-white shadow-pop sm:px-12">
    <Doodle name="sparkle" class="absolute left-8 top-8 h-10 w-10 text-white/40 animate-floaty" />
    <Doodle name="heart" class="absolute bottom-8 left-1/4 h-7 w-7 text-white/30" />
    <Doodle name="asterisk" class="absolute right-10 top-10 h-8 w-8 text-white/40" />
    <Doodle name="star" class="absolute bottom-10 right-12 h-9 w-9 text-white/30 animate-floaty" />

    <p class="font-hand text-3xl text-white/90">follow along</p>
    <h2 class="mt-1 text-3xl font-semibold text-white sm:text-4xl">New pieces drop on Instagram</h2>
    <p class="mx-auto mt-3 max-w-md text-white/85">
      See works in progress, behind-the-scenes chaos, and the newest jewelry before it lands here.
    </p>
    <div class="mt-6 flex justify-center">
      <Button
        href={site.instagram.url}
        variant="outline"
        size="lg"
        class="!bg-white !text-bubblegum-ink !border-white"
        target="_blank"
        rel="noopener noreferrer"
      >
        @{site.instagram.handle}
      </Button>
    </div>
  </div>
</section>
