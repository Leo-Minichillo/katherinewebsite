---
// Self-hosted fonts (no external requests, no layout shift).
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/nunito';
import '@fontsource/caveat';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { link } from '../lib/helpers';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = site.shortPitch, image } = Astro.props;
const fullTitle = title ? `${title} · ${site.brand}` : `${site.brand} · ${site.owner}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? link('/og-image.svg'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={link('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFF7F0" />

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only rounded-full focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:bg-bubblegum focus:px-5 focus:py-2 focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
